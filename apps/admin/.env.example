# Clerk Authentication
# Get these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx

# Clerk URLs - adjust based on your domain
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Clerk JWT Issuer (for Convex auth)
# Format: https://your-clerk-domain.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=

# Convex
# Get these from https://dashboard.convex.dev
# Run `npx convex dev` to get your deployment URL
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3001
