{
  "name": "steding-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for Leroy Steding's projects",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "convex:clean": "bash scripts/clean-convex.sh",
    "convex:deploy": "pnpm convex:clean && npx convex deploy --yes --typecheck=disable",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/node": "^25.3.3",
    "dotenv": "^17.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "turbo": "^2.7.3",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "dependencies": {
    "@linear/sdk": "^75.0.0",
    "@sanity/document-internationalization": "^4.1.0",
    "@swc/helpers": "^0.5.18",
    "convex": "^1.32.0",
    "puppeteer": "^24.37.5",
    "sanity-plugin-markdown": "^6.0.0"
  },
  "pnpm": {
    "overrides": {
      "@swc/helpers": "^0.5.18"
    }
  }
}
